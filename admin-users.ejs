<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/Favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <title>KaliNet — Gestion des utilisateurs</title>
</head>
<body>

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
    KaliNet
  </a>
  <div class="navbar-links">
    <a href="/">Fil</a>
    <a href="/admin/users" class="active danger">Utilisateurs</a>
    <a href="/admin/reports" style="color:var(--yellow)">Signalements</a>
    <a href="/admin/messages" style="color:var(--blue)">Messages</a>
  </div>
  <div class="navbar-user">
    <span class="badge badge-admin">👑 Admin</span>
    <a href="/logout" class="btn btn-ghost btn-sm">Déco</a>
  </div>
</nav>

<div class="page-wrapper" style="max-width:1100px;">

  <div class="flex items-center justify-between mb-md" style="flex-wrap:wrap;gap:0.75rem;">
    <div class="section-title" style="margin-bottom:0;">Gestion des utilisateurs</div>
    <div id="statsBar" class="flex gap-sm" style="flex-wrap:wrap;font-size:0.75rem;color:var(--text2);">
      <span>Total : <strong id="totalUsers" class="text-accent">—</strong></span>
      <span>·</span>
      <span>Admins : <strong id="totalAdmins" style="color:var(--red)">—</strong></span>
      <span>·</span>
      <span>VIP : <strong id="totalVip" style="color:var(--yellow)">—</strong></span>
      <span>·</span>
      <span>Premium : <strong id="totalPremium" style="color:#a78bfa">—</strong></span>
    </div>
  </div>

  <div class="form-group mb-md">
    <input type="text" id="searchInput" placeholder="Rechercher un utilisateur...">
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Pseudo</th>
          <th>Rang actuel</th>
          <th>Modifier le rang</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody">
        <tr><td colspan="5" class="text-muted text-sm" style="padding:1.5rem;text-align:center;">Chargement...</td></tr>
      </tbody>
    </table>
  </div>

</div>

<script>
  let usersData = [];

  async function loadUsers() {
    const res = await fetch('/api/admin/users');
    usersData = await res.json();
    updateStats();
    renderTable();
  }

  function updateStats() {
    document.getElementById('totalUsers').innerText  = usersData.length;
    document.getElementById('totalAdmins').innerText = usersData.filter(u => u.rank === 'admin').length;
    document.getElementById('totalVip').innerText    = usersData.filter(u => u.rank === 'vip').length;
    document.getElementById('totalPremium').innerText= usersData.filter(u => u.rank === 'premium').length;
  }

  const rankLabel = { admin:'👑 Admin', vip:'⭐ VIP', premium:'💎 Premium', banned:'🔒 Banni', tester:'🧪 Testeur', user:'👤 Membre' };

  function renderTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    const list = usersData.filter(u => u.username.toLowerCase().includes(q));
    const tbody = document.getElementById('usersTableBody');
    if (!list.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-muted text-sm" style="padding:1.5rem;text-align:center;">Aucun utilisateur trouvé</td></tr>';
      return;
    }
    tbody.innerHTML = list.map(u => `
      <tr>
        <td class="text-muted text-xs">${u.id}</td>
        <td><strong>${escapeHtml(u.username)}</strong></td>
        <td><span class="badge badge-${u.rank}">${rankLabel[u.rank] || u.rank}</span></td>
        <td>
          <select id="rank-select-${u.id}" style="width:auto;padding:0.3rem 0.5rem;font-size:0.8rem;">
            <option value="user"    ${u.rank==='user'    ?'selected':''}>👤 Membre</option>
            <option value="vip"     ${u.rank==='vip'     ?'selected':''}>⭐ VIP</option>
            <option value="premium" ${u.rank==='premium' ?'selected':''}>💎 Premium</option>
            <option value="tester"  ${u.rank==='tester'  ?'selected':''}>🧪 Testeur</option>
            <option value="banned"  ${u.rank==='banned'  ?'selected':''}>🔒 Banni</option>
            <option value="admin"   ${u.rank==='admin'   ?'selected':''}>👑 Admin</option>
          </select>
        </td>
        <td class="flex gap-sm" style="flex-wrap:wrap;">
          <button class="btn btn-green btn-sm" onclick="updateRank(${u.id})">Appliquer</button>
          <button class="btn btn-danger btn-sm" onclick="deleteUser(${u.id})">Supprimer</button>
        </td>
      </tr>
    `).join('');
  }

  async function updateRank(userId) {
    const rank = document.getElementById(`rank-select-${userId}`).value;
    const res = await fetch('/api/admin/users/rank', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId, rank }) });
    if (res.ok) loadUsers();
    else alert('❌ Erreur');
  }

  async function deleteUser(userId) {
    if (!confirm('Supprimer définitivement cet utilisateur ?')) return;
    const res = await fetch('/api/admin/users/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ userId }) });
    if (res.ok) loadUsers();
    else { const d = await res.json(); alert('❌ ' + (d.error || 'Erreur')); }
  }

  function escapeHtml(s) {
    return s.replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));
  }

  document.getElementById('searchInput').addEventListener('input', renderTable);
  loadUsers();
</script>
</body>
</html>
