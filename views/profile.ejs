<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/Favicon.ico">
    <link rel="stylesheet" href="/style.css">
    <title>KaliNet - <%= targetUser.username %></title>
</head>
<body>

<nav class="navbar">
    <a href="/" class="navbar-brand">
        <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
        KaliNet
    </a>
    <div class="navbar-links">
        <a href="/">🏠 Fil</a>
        <a href="/messages">💬 Messages</a>
        <a href="/profile/<%= user.id %>" class="active">👤 Profil</a>
        <a href="/contact">📨 Contact</a>
        <a href="/my-tickets">📋 Tickets</a>
        <% if (user.is_admin) { %>
            <a href="/admin/users" class="danger">👑 Admin</a>
            <a href="/admin/messages" style="position:relative;">
                📩 Messages <span id="unreadBadge" style="display:none;background:var(--red);color:white;border-radius:2rem;padding:0.1rem 0.4rem;font-size:0.65rem;">0</span>
            </a>
        <% } %>
    </div>
    <div class="navbar-user">
        <a href="/logout" class="btn btn-ghost btn-sm">Déconnexion</a>
    </div>
</nav>

<div class="page-wrapper">

    <div class="profile-header">
        <div class="profile-avatar">
            <%= targetUser.username.charAt(0).toUpperCase() %>
        </div>
        <div class="profile-name"><%= targetUser.username %></div>
        <div class="mt-sm">
            <span class="badge badge-<%= targetUser.rank %>">
                <% if (targetUser.rank === 'admin') { %>👑 Admin
                <% } else if (targetUser.rank === 'vip') { %>⭐ VIP
                <% } else if (targetUser.rank === 'premium') { %>💎 Premium
                <% } else if (targetUser.rank === 'tester') { %>🧪 Testeur
                <% } else if (targetUser.rank === 'banned') { %>🔒 Banni
                <% } else { %>👤 Utilisateur<% } %>
            </span>
        </div>
        <div class="profile-bio"><%= targetUser.bio || 'Aucune bio renseignée.' %></div>
        <div class="profile-meta">Membre depuis le <%= new Date(targetUser.created_at).toLocaleDateString('fr-FR') %></div>
        <div class="mt-md">
            <% if (targetUser.id == user.id) { %>
                <button class="btn btn-ghost btn-sm" onclick="editBio()">✏️ Modifier ma bio</button>
            <% } else { %>
                <a href="/messages" class="btn btn-primary btn-sm">💬 Envoyer un message</a>
            <% } %>
        </div>
    </div>

    <div class="section-title">📝 Posts de <%= targetUser.username %></div>

    <% if (posts.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            Aucun post pour l'instant.
        </div>
    <% } else { %>
        <% posts.forEach(post => { %>
            <div class="post-card">
                <div class="post-time text-xs text-muted mb-sm"><%= new Date(post.created_at).toLocaleString('fr-FR') %></div>
                <div class="post-content"><%= post.content %></div>
            </div>
        <% }) %>
    <% } %>

</div>

<script>
    function editBio() {
        const newBio = prompt('Nouvelle bio (max 300 caractères) :', '<%= targetUser.bio || "" %>');
        if (newBio !== null) {
            fetch('/api/profile/bio', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ bio: newBio }) })
            .then(() => location.reload());
        }
    }

    async function checkUnreadMessages() {
        <% if (user.is_admin) { %>
        try {
            const res = await fetch('/api/admin/messages/unread-count');
            const data = await res.json();
            const badge = document.getElementById('unreadBadge');
            if (badge) { badge.innerText = data.count || 0; badge.style.display = (data.count > 0) ? 'inline' : 'none'; }
        } catch(e) {}
        <% } %>
    }
    setInterval(checkUnreadMessages, 30000);
    checkUnreadMessages();
</script>
</body>
</html>
