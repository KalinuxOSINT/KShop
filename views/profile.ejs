<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/Favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
  <title>KaliNet — <%= targetUser.username %></title>
</head>
<body>

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
    KaliNet
  </a>
  <div class="navbar-links">
    <a href="/">Fil</a>
    <a href="/servers">Serveurs</a>
    <a href="/messages">Messages</a>
    <a href="/profile/<%= user.id %>" class="active">Profil</a>
    <a href="/contact">Contact</a>
    <a href="/my-tickets">Tickets</a>
    <% if (user.is_admin) { %>
      <a href="/admin/users" class="danger">Admin</a>
      <a href="/admin/messages">
        Messages
        <span id="unreadBadge" style="display:none;background:var(--red);color:white;border-radius:2rem;padding:0.1rem 0.4rem;font-size:0.62rem;">0</span>
      </a>
    <% } %>
  </div>
  <div class="navbar-user">
    <a href="/logout" class="btn btn-ghost btn-sm">Déco</a>
  </div>
</nav>

<div class="page-wrapper">

  <div class="profile-header">
    <div class="profile-avatar">
      <%= targetUser.username.charAt(0).toUpperCase() %>
    </div>
    <div class="profile-name"><%= targetUser.username %></div>
    <div class="mt-sm">
      <span class="badge badge-<%= targetUser.rank %>">
        <% if (targetUser.rank==='admin') { %>👑 Admin
        <% } else if (targetUser.rank==='vip') { %>⭐ VIP
        <% } else if (targetUser.rank==='premium') { %>💎 Premium
        <% } else if (targetUser.rank==='tester') { %>🧪 Testeur
        <% } else if (targetUser.rank==='banned') { %>🔒 Banni
        <% } else { %>👤 Membre<% } %>
      </span>
    </div>
    <div class="profile-bio"><%= targetUser.bio || 'Aucune bio renseignée.' %></div>
    <div class="profile-meta">Membre depuis le <%= new Date(targetUser.created_at).toLocaleDateString('fr-FR') %></div>
    <div class="mt-md flex" style="justify-content:center;gap:0.5rem;">
      <% if (targetUser.id == user.id) { %>
        <button class="btn btn-ghost btn-sm" onclick="editBio()">✏️ Modifier ma bio</button>
        <button class="btn btn-ghost btn-sm" onclick="document.getElementById('settingsPanel').scrollIntoView({behavior:'smooth'})">⚙️ Paramètres</button>
      <% } else { %>
        <a href="/messages" class="btn btn-primary btn-sm">💬 Message</a>
      <% } %>
    </div>
  </div>

  <% if (targetUser.id == user.id) { %>
  <div id="settingsPanel" class="mt-lg">
    <div class="section-title">⚙️ Paramètres</div>

    <div class="settings-section">
      <div class="flex items-center justify-between">
        <div>
          <div class="settings-label">Apparence</div>
          <div class="settings-desc">Choisis entre le mode clair et le mode sombre</div>
        </div>
        <button class="theme-toggle" onclick="toggleTheme()" id="themeToggleBtn">
          <span id="themeLabel">☀️ Clair</span>
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
        </button>
      </div>
    </div>

  </div>
  <% } %>

  <div class="section-title">Posts de <%= targetUser.username %></div>

  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon">📭</span>
      Aucun post pour l'instant.
    </div>
  <% } else { %>
    <% posts.forEach(post => { %>
      <div class="post-card">
        <div class="post-time mb-sm text-xs"><%= new Date(post.created_at).toLocaleString('fr-FR') %></div>
        <div class="post-content"><%= post.content %></div>
      </div>
    <% }) %>
  <% } %>

</div>

<script>
  // ===== THEME =====
  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('kn-theme', theme);
    const label = document.getElementById('themeLabel');
    if (label) label.textContent = theme === 'dark' ? '🌙 Sombre' : '☀️ Clair';
  }
  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  }
  // Appliquer au chargement
  applyTheme(localStorage.getItem('kn-theme') || 'light');

  function editBio() {
    const newBio = prompt('Nouvelle bio (max 300 caractères) :', '<%= (targetUser.bio || "").replace(/'/g, "\\'") %>');
    if (newBio !== null) {
      fetch('/api/profile/bio', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ bio: newBio }) })
        .then(() => location.reload());
    }
  }

  async function checkUnread() {
    <% if (user.is_admin) { %>
    try {
      const data = await (await fetch('/api/admin/messages/unread-count')).json();
      const badge = document.getElementById('unreadBadge');
      if (badge) { badge.innerText = data.count||0; badge.style.display = data.count > 0 ? 'inline' : 'none'; }
    } catch(e) {}
    <% } %>
  }
  setInterval(checkUnread, 30000);
  checkUnread();
</script>
</body>
</html>
