<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/Favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <title>KaliNet — Signalements</title>
</head>
<body>

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
    KaliNet
  </a>
  <div class="navbar-links">
    <a href="/">Fil</a>
    <a href="/admin/users" class="danger">Utilisateurs</a>
    <a href="/admin/reports" class="active" style="color:var(--yellow)">Signalements</a>
    <a href="/admin/messages" style="color:var(--blue)">Messages</a>
  </div>
  <div class="navbar-user">
    <span class="badge badge-admin">👑 Admin</span>
    <a href="/logout" class="btn btn-ghost btn-sm">Déco</a>
  </div>
</nav>

<div class="page-wrapper">
  <div class="section-title">Signalements</div>

  <% if (reports.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon">✅</span>
      Aucun signalement en attente.
    </div>
  <% } else { %>
    <% reports.forEach(r => { %>
      <div class="ticket-card <%= r.status === 'resolved' ? 'resolved' : 'pending' %>" style="border-left-color:var(--yellow);">
        <div class="flex items-center gap-sm mb-sm" style="flex-wrap:wrap;">
          <span class="ticket-subject">Signalement</span>
          <span class="status-badge <%= r.status === 'resolved' ? 'status-resolved' : 'status-pending' %>">
            <%= r.status === 'resolved' ? '✅ Traité' : '⏳ En attente' %>
          </span>
          <span class="text-xs text-muted ml-auto"><%= new Date(r.created_at).toLocaleString('fr-FR') %></span>
        </div>
        <div class="text-sm mb-sm">
          Signalé par <strong><%= r.reporter?.username %></strong>
          — Raison : <em><%= r.reason %></em>
        </div>
        <div class="ticket-message">
          <div class="text-xs text-muted mb-sm">Post incriminé par <strong><%= r.posts?.users?.username %></strong></div>
          "<%= r.posts?.content %>"
        </div>
        <% if (r.status !== 'resolved') { %>
          <div class="flex gap-sm mt-sm">
            <button class="btn btn-danger btn-sm" onclick="deletePost(<%= r.posts?.id %>, <%= r.id %>)">Supprimer le post</button>
            <button class="btn btn-ghost btn-sm" onclick="ignoreReport(<%= r.id %>)" style="color:var(--green)">Ignorer</button>
          </div>
        <% } %>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
  async function deletePost(postId, reportId) {
    if (!confirm('Supprimer ce post ?')) return;
    const res = await fetch('/api/admin/reports/delete-post', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ postId, reportId }) });
    if (res.ok) location.reload(); else alert('Erreur');
  }
  async function ignoreReport(reportId) {
    const res = await fetch('/api/admin/reports/ignore', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ reportId }) });
    if (res.ok) location.reload(); else alert('Erreur');
  }
</script>
</body>
</html>
