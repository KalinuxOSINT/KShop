<!DOCTYPE html>
<html>
<head>
    <title>KaliNet - Signalements</title>
    <style>
        body{background:#0a0c12;color:#eee;font-family:Arial;padding:2rem;}
        .container{max-width:1000px;margin:0 auto;}
        .report-card{background:#1a1f2e;border-radius:1rem;padding:1rem;margin-bottom:1rem;border-left:4px solid #ffaa00;}
        .report-card.resolved{border-left-color:#00ffcc;opacity:0.7;}
        .post-content{background:#0a0c12;padding:0.5rem;border-radius:0.5rem;margin:0.5rem 0;}
        button{background:#ff4444;color:white;padding:0.5rem 1rem;border:none;border-radius:2rem;cursor:pointer;}
        .nav a{color:#00ffcc;text-decoration:none;margin-right:1rem;}
        .ignore-btn{background:#00aaff;}
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="/admin/users">👥 Utilisateurs</a>
        <a href="/admin/messages">📩 Messages</a>
        <a href="/">🏠 Accueil</a>
    </div>
    <h1>🚩 Signalements</h1>
    <% if (reports.length === 0) { %>
        <p>Aucun signalement.</p>
    <% } else { %>
        <% reports.forEach(r => { %>
            <div class="report-card <%= r.status %>">
                <div><strong>📅 <%= new Date(r.created_at).toLocaleString() %></strong></div>
                <div>👤 Signalé par : <strong><%= r.reporter?.username %></strong></div>
                <div>📝 Raison : <em><%= r.reason %></em></div>
                <div class="post-content">
                    <strong>Post incriminé :</strong><br>
                    "<%= r.posts?.content %>"<br>
                    <small>par <%= r.posts?.users?.username %></small>
                </div>
                <button onclick="deletePost(<%= r.posts?.id %>, <%= r.id %>)">🗑️ Supprimer le post</button>
                <button class="ignore-btn" onclick="ignoreReport(<%= r.id %>)">✅ Ignorer</button>
            </div>
        <% }) %>
    <% } %>
</div>
<script>
    async function deletePost(postId, reportId) {
        if (!confirm('Supprimer ce post ?')) return;
        const res = await fetch('/api/admin/reports/delete-post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId, reportId })
        });
        if (res.ok) location.reload();
        else alert('Erreur');
    }
    async function ignoreReport(reportId) {
        const res = await fetch('/api/admin/reports/ignore', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reportId })
        });
        if (res.ok) location.reload();
        else alert('Erreur');
    }
</script>
</body>
</html>
