<!DOCTYPE html>
<html>
<head>
    <title>KaliNet - Fil d'actualité</title>
    <style>
        body{background:#0a0c12;color:#eee;font-family:Arial;padding:2rem;}
        .container{max-width:800px;margin:0 auto;}
        .post-card{background:#1a1f2e;border-radius:1rem;padding:1rem;margin-bottom:1rem;}
        .nav{display:flex;gap:1rem;margin-bottom:2rem;flex-wrap:wrap;}
        .nav a{color:#00ffcc;text-decoration:none;}
        textarea{width:100%;padding:0.5rem;background:#1e2332;border:1px solid #00ffcc;color:white;border-radius:0.5rem;}
        button{background:#00ffcc;color:black;padding:0.5rem 1rem;border:none;border-radius:2rem;cursor:pointer;}
        .rank-badge{font-size:0.7rem;padding:0.1rem 0.4rem;border-radius:1rem;background:#2a2e3f;}
        .banned-user{text-decoration:line-through;color:#ff4444;}
        a.profile-link{text-decoration:none;color:#00ffcc;}
        a.profile-link:hover{text-decoration:underline;}
        #unreadBadge{background:#ff4444;color:white;border-radius:50%;padding:0.1rem 0.4rem;font-size:0.7rem;margin-left:0.3rem;}
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <span>👋 <%= user.username %> (<%= user.rank %>)</span>
        <a href="/">🏠 Fil</a>
        <a href="/messages">💬 Messages</a>
        <a href="/profile/<%= user.id %>">👤 Mon profil</a>
        <a href="/contact">📨 Contact</a>
        <a href="/my-tickets">📋 Mes tickets</a>
        <% if (user.is_admin) { %>
            <a href="/admin/users" style="color:#ff4444;">👑 Admin</a>
            <a href="/admin/messages" id="adminMessagesLink" style="position:relative;">
                📩 Messages <span id="unreadBadge">0</span>
            </a>
        <% } %>
        <a href="/logout">🚪 Déconnexion</a>
    </div>

    <h2>📝 Nouveau post</h2>
    <textarea id="postContent" rows="3" placeholder="Publie un message, un tutoriel, un hack éthique..."></textarea>
    <button onclick="sendPost()">📤 Publier</button>

    <h2>📰 Fil d'actualité</h2>
    <div id="postsContainer">
        <% posts.forEach(post => { %>
            <div class="post-card">
                <div>
                    <a href="/profile/<%= post.user_id %>" class="profile-link">
                        <strong><%= post.users.username %></strong>
                    </a>
                    <span class="rank-badge">
                        <% if (post.users.rank === 'admin') { %>👑
                        <% } else if (post.users.rank === 'vip') { %>⭐
                        <% } else if (post.users.rank === 'premium') { %>💎
                        <% } else if (post.users.rank === 'tester') { %>🧪
                        <% } else if (post.users.rank === 'banned') { %>🔒
                        <% } else { %>👤<% } %>
                    </span>
                </div>
                <div style="font-size:0.8rem;"><%= new Date(post.created_at).toLocaleString() %></div>
                <p><%= post.content %></p>
            </div>
        <% }) %>
    </div>
</div>
<script>
    async function sendPost() {
        const content = document.getElementById('postContent').value;
        if (!content.trim()) return alert('Message vide');
        const res = await fetch('/api/post', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({content}) });
        if (res.ok) location.reload();
        else alert('Erreur');
    }

    async function checkUnreadMessages() {
        <% if (user.is_admin) { %>
            const res = await fetch('/api/admin/messages/unread-count');
            const data = await res.json();
            const badge = document.getElementById('unreadBadge');
            if (badge) {
                const count = data.count || 0;
                badge.innerText = count;
                badge.style.display = count > 0 ? 'inline' : 'none';
            }
        <% } %>
    }
    setInterval(checkUnreadMessages, 30000);
    checkUnreadMessages();
</script>
</body>
</html>
