<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/Favicon.ico">
    <link rel="stylesheet" href="/style.css">
    <title>KaliNet - Fil d'actualité</title>
</head>
<body>

<nav class="navbar">
    <a href="/" class="navbar-brand">
        <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
        KaliNet
    </a>
    <div class="navbar-links">
        <a href="/" class="active">🏠 Fil</a>
        <a href="/messages">💬 Messages</a>
        <a href="/profile/<%= user.id %>">👤 Profil</a>
        <a href="/contact">📨 Contact</a>
        <a href="/my-tickets">📋 Tickets</a>
        <% if (user.is_admin) { %>
            <a href="/admin/users" class="danger">👑 Admin</a>
            <a href="/admin/reports" style="color:var(--yellow)">🚩 Signalements</a>
            <a href="/admin/messages" style="position:relative;">
                📩 Messages <span id="unreadBadge" style="display:none;background:var(--red);color:white;border-radius:2rem;padding:0.1rem 0.4rem;font-size:0.65rem;margin-left:0.2rem;">0</span>
            </a>
        <% } %>
    </div>
    <div class="navbar-user">
        <span class="badge badge-<%= user.rank %>">
            <% if (user.rank === 'admin') { %>👑
            <% } else if (user.rank === 'vip') { %>⭐
            <% } else if (user.rank === 'premium') { %>💎
            <% } else if (user.rank === 'tester') { %>🧪
            <% } else { %>👤<% } %>
            <%= user.username %>
        </span>
        <a href="/logout" class="btn btn-ghost btn-sm">Déconnexion</a>
    </div>
</nav>

<div class="page-wrapper">

    <div class="compose-box">
        <div class="section-title">✏️ Nouveau post</div>
        <textarea id="postContent" rows="3" placeholder="Publie un message, un tuto, une découverte..."></textarea>
        <div class="flex" style="justify-content:flex-end;">
            <button class="btn btn-primary" onclick="sendPost()">📤 Publier</button>
        </div>
    </div>

    <div class="section-title">📰 Fil d'actualité</div>

    <% if (posts.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            Aucun post pour l'instant. Sois le premier à publier !
        </div>
    <% } else { %>
        <% posts.forEach(post => { %>
            <div class="post-card" id="post-<%= post.id %>">
                <div class="post-author">
                    <a href="/profile/<%= post.user_id %>"><%= post.users.username %></a>
                    <span class="badge badge-<%= post.users.rank %>">
                        <% if (post.users.rank === 'admin') { %>👑
                        <% } else if (post.users.rank === 'vip') { %>⭐
                        <% } else if (post.users.rank === 'premium') { %>💎
                        <% } else if (post.users.rank === 'tester') { %>🧪
                        <% } else if (post.users.rank === 'banned') { %>🔒
                        <% } else { %>👤<% } %>
                        <%= post.users.rank %>
                    </span>
                    <span class="post-time ml-auto"><%= new Date(post.created_at).toLocaleString('fr-FR') %></span>
                </div>
                <div class="post-content"><%= post.content %></div>
                <div class="post-actions mt-sm">
                    <% if (user.is_admin || user.id === post.user_id) { %>
                        <button class="btn btn-danger btn-sm" onclick="deletePost(<%= post.id %>)">🗑️ Supprimer</button>
                    <% } %>
                    <% if (!user.is_admin && user.id !== post.user_id) { %>
                        <button class="btn btn-warning btn-sm" onclick="reportPost(<%= post.id %>)">🚩 Signaler</button>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } %>

</div>

<script>
    async function sendPost() {
        const content = document.getElementById('postContent').value;
        if (!content.trim()) return;
        const res = await fetch('/api/post', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({content}) });
        if (res.ok) location.reload();
        else alert('Erreur lors de la publication');
    }

    async function deletePost(postId) {
        if (!confirm('Supprimer ce post ?')) return;
        const res = await fetch('/api/post/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ postId }) });
        if (res.ok) document.getElementById(`post-${postId}`).remove();
        else alert('Erreur lors de la suppression');
    }

    async function reportPost(postId) {
        const reason = prompt('Pourquoi signalez-vous ce post ?');
        if (!reason) return;
        const res = await fetch('/api/post/report', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ postId, reason }) });
        if (res.ok) alert('✅ Signalement envoyé');
        else alert('❌ Erreur');
    }

    async function checkUnreadMessages() {
        <% if (user.is_admin) { %>
        try {
            const res = await fetch('/api/admin/messages/unread-count');
            const data = await res.json();
            const badge = document.getElementById('unreadBadge');
            if (badge) {
                const count = data.count || 0;
                badge.innerText = count;
                badge.style.display = count > 0 ? 'inline' : 'none';
            }
        } catch(e) {}
        <% } %>
    }
    setInterval(checkUnreadMessages, 30000);
    checkUnreadMessages();
</script>
</body>
</html>
