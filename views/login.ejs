<!DOCTYPE html>
<html>
<head>
    <link rel="icon" type="image/x-icon" href="/Favicon.ico">
    <link rel="icon" type="image/x-icon" href="/Favicon.ico">
    <title>Kalinux - Connexion</title>
    <style>
        body{background:#0a0c12;color:#eee;text-align:center;padding:2rem;font-family:Arial;}
        .logo{width:80px;height:auto;margin-bottom:1rem;}
        input,button{padding:0.5rem;margin:0.5rem;border-radius:0.5rem;}
        button{background:#00ffcc;color:black;border:none;cursor:pointer;}
        a{color:#00ffcc;}
    </style>
</head>
<body>
    <img src="/Kalinux.png" alt="Kalinux Logo" class="logo" onerror="this.style.display='none'">
    <h1>🔐 Connexion</h1>
    <form method="post">
        <input name="username" placeholder="Pseudo" required><br>
        <input type="password" name="password" placeholder="Mot de passe" required><br>
        <button type="submit">Se connecter</button>
    </form>
    <a href="/register">Créer un compte</a>
</body>
</html>
