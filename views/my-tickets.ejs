<!DOCTYPE html>
<html>
<head>
    <title>KaliNet - Mes tickets</title>
    <style>
        body{background:#0a0c12;color:#eee;font-family:Arial;padding:2rem;}
        .container{max-width:800px;margin:0 auto;}
        .ticket{background:#1a1f2e;border-radius:1rem;padding:1rem;margin-bottom:1rem;border-left:4px solid #00ffcc;}
        .ticket.resolved{border-left-color:#ff4444;opacity:0.7;}
        .ticket.replied{border-left-color:#ffaa00;}
        .subject{font-size:1.2rem;font-weight:bold;color:#00ffcc;}
        .status{font-size:0.8rem;padding:0.2rem 0.5rem;border-radius:1rem;display:inline-block;margin-left:0.5rem;}
        .status.pending{background:#ffaa00;color:black;}
        .status.replied{background:#00aaff;color:white;}
        .status.resolved{background:#ff4444;color:white;}
        .message{background:#1e2332;padding:0.5rem;border-radius:0.5rem;margin:0.5rem 0;}
        .admin-reply{background:#0a0c12;border:1px solid #00ffcc;padding:0.5rem;border-radius:0.5rem;margin-top:0.5rem;}
        .nav a{color:#00ffcc;text-decoration:none;margin-right:1rem;}
        .date{font-size:0.7rem;color:#888;margin-top:0.5rem;}
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="/">🏠 Accueil</a>
        <a href="/contact">📨 Nouveau message</a>
    </div>
    <h1>📋 Mes tickets</h1>
    <% if (tickets.length === 0) { %>
        <p>Aucun message envoyé. <a href="/contact">Contacter le support</a></p>
    <% } else { %>
        <% tickets.forEach(t => { %>
            <div class="ticket <%= t.status %>">
                <div>
                    <span class="subject"><%= t.subject %></span>
                    <span class="status <%= t.status %>">
                        <% if (t.status === 'pending') { %>⏳ En attente<% } 
                           else if (t.status === 'replied') { %>💬 Répondu<% } 
                           else { %>✅ Résolu<% } %>
                    </span>
                </div>
                <div class="message"><%= t.message %></div>
                <% if (t.admin_reply) { %>
                    <div class="admin-reply">
                        <strong>🔹 Réponse de l'admin :</strong><br>
                        <%= t.admin_reply %>
                        <div class="date"><%= new Date(t.replied_at).toLocaleString() %></div>
                    </div>
                <% } %>
                <div class="date">Envoyé le : <%= new Date(t.created_at).toLocaleString() %></div>
            </div>
        <% }) %>
    <% } %>
</div>
</body>
</html>
