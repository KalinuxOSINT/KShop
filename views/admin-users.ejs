<!DOCTYPE html>
<html lang="fr">
<head>
    <link rel="icon" type="image/x-icon" href="/Favicon.ico">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalinux - Gestion des utilisateurs</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0a0c12;
            color: #e3e3e3;
            font-family: 'Segoe UI', 'Courier New', monospace;
            padding: 2rem;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #00ffcc;
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }
        .header h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #00ffcc, #ff44cc);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .back-link {
            display: inline-block;
            margin-top: 1rem;
            color: #00ffcc;
            text-decoration: none;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #11141f;
            border-radius: 1rem;
            overflow: hidden;
        }
        th, td {
            padding: 1rem;
            text-align: left;
            border-bottom: 1px solid #2a2e3f;
        }
        th {
            background: #1a1f2e;
            color: #00ffcc;
            font-weight: bold;
        }
        tr:hover {
            background: #1e2332;
        }
        .rank-badge {
            display: inline-block;
            padding: 0.2rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.8rem;
            font-weight: bold;
        }
        .rank-admin { background: #ff4444; color: white; }
        .rank-vip { background: #ffaa00; color: black; }
        .rank-premium { background: #aa44ff; color: white; }
        .rank-user { background: #2a2e3f; color: #00ffcc; }
        .rank-banned { background: #222; color: #ff4444; text-decoration: line-through; }
        .rank-tester { background: #00aaff; color: black; }
        select, button {
            padding: 0.4rem 0.8rem;
            border-radius: 0.5rem;
            border: none;
            cursor: pointer;
            font-family: monospace;
        }
        select {
            background: #1e2332;
            color: white;
            border: 1px solid #2a2e3f;
        }
        button {
            background: #00ffcc;
            color: black;
            font-weight: bold;
        }
        button.delete-btn {
            background: #ff4444;
            color: white;
        }
        .search-box {
            margin-bottom: 1rem;
            display: flex;
            gap: 0.5rem;
        }
        .search-box input {
            flex: 1;
            padding: 0.5rem;
            background: #1e2332;
            border: 1px solid #2a2e3f;
            border-radius: 0.5rem;
            color: white;
        }
        .stats {
            margin: 1rem 0;
            padding: 1rem;
            background: #1a1f2e;
            border-radius: 0.5rem;
            display: inline-block;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>👥 Gestion des utilisateurs</h1>
        <p>Attribuer des rangs, modifier, supprimer</p>
        <a href="/" class="back-link">← Retour à l'accueil</a>
    </div>

    <div class="stats">
        📊 Total utilisateurs : <strong id="totalUsers">0</strong> | 
        👑 Admins : <strong id="totalAdmins">0</strong> | 
        ⭐ VIP : <strong id="totalVip">0</strong> | 
        💎 Premium : <strong id="totalPremium">0</strong>
    </div>

    <div class="search-box">
        <input type="text" id="searchInput" placeholder="🔍 Rechercher un utilisateur...">
    </div>

    <div style="overflow-x: auto;">
         <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Pseudo</th>
                    <th>Rang actuel</th>
                    <th>Nouveau rang</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                <tr><td colspan="5">Chargement...</td></tr>
            </tbody>
         </table>
    </div>
</div>

<script>
    let usersData = [];

    async function loadUsers() {
        const response = await fetch('/api/admin/users');
        usersData = await response.json();
        updateStats();
        renderTable();
    }

    function updateStats() {
        document.getElementById('totalUsers').innerText = usersData.length;
        document.getElementById('totalAdmins').innerText = usersData.filter(u => u.rank === 'admin').length;
        document.getElementById('totalVip').innerText = usersData.filter(u => u.rank === 'vip').length;
        document.getElementById('totalPremium').innerText = usersData.filter(u => u.rank === 'premium').length;
    }

    function getRankClass(rank) {
        switch(rank) {
            case 'admin': return 'rank-admin';
            case 'vip': return 'rank-vip';
            case 'premium': return 'rank-premium';
            case 'banned': return 'rank-banned';
            case 'tester': return 'rank-tester';
            default: return 'rank-user';
        }
    }

    function getRankLabel(rank) {
        switch(rank) {
            case 'admin': return '👑 Admin';
            case 'vip': return '⭐ VIP';
            case 'premium': return '💎 Premium';
            case 'banned': return '🔒 Banni';
            case 'tester': return '🧪 Testeur';
            default: return '👤 Utilisateur';
        }
    }

    function renderTable() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const filtered = usersData.filter(u => u.username.toLowerCase().includes(searchTerm));
        
        const tbody = document.getElementById('usersTableBody');
        if (filtered.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5">Aucun utilisateur trouvé</td></tr>';
            return;
        }
        
        tbody.innerHTML = filtered.map(user => `
            <tr>
                <td>${user.id}</td>
                <td><strong>${escapeHtml(user.username)}</strong></td>
                <td><span class="rank-badge ${getRankClass(user.rank)}">${getRankLabel(user.rank)}</span></td>
                <td>
                    <select id="rank-select-${user.id}">
                        <option value="user" ${user.rank === 'user' ? 'selected' : ''}>👤 Utilisateur</option>
                        <option value="vip" ${user.rank === 'vip' ? 'selected' : ''}>⭐ VIP</option>
                        <option value="premium" ${user.rank === 'premium' ? 'selected' : ''}>💎 Premium</option>
                        <option value="tester" ${user.rank === 'tester' ? 'selected' : ''}>🧪 Testeur</option>
                        <option value="banned" ${user.rank === 'banned' ? 'selected' : ''}>🔒 Banni</option>
                        <option value="admin" ${user.rank === 'admin' ? 'selected' : ''}>👑 Admin</option>
                    </select>
                </td>
                <td>
                    <button onclick="updateRank(${user.id})">✅ Appliquer</button>
                    <button class="delete-btn" onclick="deleteUser(${user.id})">🗑️ Supprimer</button>
                </td>
            </tr>
        `).join('');
    }

    async function updateRank(userId) {
        const select = document.getElementById(`rank-select-${userId}`);
        const newRank = select.value;
        
        const response = await fetch('/api/admin/users/rank', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, rank: newRank })
        });
        
        if (response.ok) {
            loadUsers();
        } else {
            alert('❌ Erreur lors de la mise à jour du rang');
        }
    }

    async function deleteUser(userId) {
        if (!confirm('⚠️ Supprimer définitivement cet utilisateur ?')) return;
        
        const response = await fetch('/api/admin/users/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId })
        });
        
        if (response.ok) {
            loadUsers();
        } else {
            const data = await response.json();
            alert('❌ ' + (data.error || 'Erreur lors de la suppression'));
        }
    }

    function escapeHtml(str) {
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    document.getElementById('searchInput').addEventListener('input', renderTable);
    loadUsers();
</script>
</body>
</html>
