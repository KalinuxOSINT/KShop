<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/Favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
  <title>KaliNet — <%= server.name %></title>
</head>
<body>

<!-- Layout Discord-like -->
<div class="discord-layout">

  <!-- Sidebar gauche : salons + membres -->
  <aside class="discord-sidebar">

    <!-- Header serveur -->
    <div class="server-sidebar-header">
      <span class="server-sidebar-icon"><%= server.icon %></span>
      <div style="flex:1;min-width:0;">
        <div class="server-sidebar-name"><%= server.name %></div>
        <div class="text-xs text-muted">Par <%= server.owner_username %></div>
      </div>
      <% if (isOwner) { %>
        <button class="btn-icon" onclick="toggleSettings()" title="Paramètres">⚙️</button>
      <% } %>
    </div>

    <!-- Salons -->
    <div class="sidebar-section">
      <div class="sidebar-section-header">
        Salons
        <% if (isOwner) { %>
          <button class="btn-icon-sm" onclick="openChannelModal()" title="Ajouter un salon">+</button>
        <% } %>
      </div>
      <% channels.forEach(ch => { %>
        <a href="/servers/<%= server.id %>?channel=<%= ch.id %>"
           class="sidebar-channel <%= ch.id === activeChannelId ? 'active' : '' %>">
          <span style="color:var(--text3);margin-right:0.3rem;">#</span>
          <%= ch.name %>
          <% if (isOwner && channels.length > 1) { %>
            <button class="btn-icon-sm ml-auto" onclick="deleteChannel(event, <%= ch.id %>)" style="opacity:0.4;">✕</button>
          <% } %>
        </a>
      <% }) %>
    </div>

    <!-- Membres -->
    <div class="sidebar-section" style="flex:1;overflow-y:auto;">
      <div class="sidebar-section-header">
        Membres (<%= members.length %>)
      </div>
      <% members.forEach(m => { %>
        <div class="sidebar-member" id="member-<%= m.id %>">
          <div class="member-avatar"><%= m.username?.charAt(0).toUpperCase() %></div>
          <div style="flex:1;min-width:0;">
            <div class="member-name">
              <%= m.username %>
              <% if (m.id === server.owner_id) { %><span style="color:var(--yellow);font-size:0.7rem;">👑</span><% } %>
            </div>
            <div class="member-roles">
              <% (m.roles || []).forEach(r => { %>
                <span class="role-pill" style="border-color:<%= r.color %>;color:<%= r.color %>">
                  <%= r.name %>
                </span>
              <% }) %>
            </div>
          </div>
          <% if (isOwner && m.id !== user.id) { %>
            <button class="btn-icon-sm" onclick="openMemberModal(<%= m.id %>, '<%= m.username %>')" style="opacity:0.5;">⚙️</button>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- Footer utilisateur -->
    <div class="discord-user-footer">
      <div class="member-avatar" style="width:32px;height:32px;font-size:0.9rem;"><%= user.username?.charAt(0).toUpperCase() %></div>
      <div style="flex:1;min-width:0;">
        <div style="font-size:0.8rem;font-weight:700;"><%= user.username %></div>
        <span class="badge badge-<%= user.rank %>" style="font-size:0.6rem;"><%= user.rank %></span>
      </div>
      <a href="/servers" class="btn-icon" title="Retour aux serveurs">🏠</a>
      <a href="/logout" class="btn-icon" title="Déconnexion">🚪</a>
    </div>

  </aside>

  <!-- Zone principale : messages -->
  <main class="discord-main">

    <!-- Header du salon actif -->
    <div class="discord-channel-header">
      <% const activeChannel = channels.find(c => c.id === activeChannelId); %>
      <span style="color:var(--text3);font-size:1.1rem;margin-right:0.4rem;">#</span>
      <span class="font-bold"><%= activeChannel?.name || 'général' %></span>
      <% if (!isOwner) { %>
        <button class="btn btn-ghost btn-sm ml-auto" onclick="leaveServer()" style="color:var(--red)">Quitter</button>
      <% } else { %>
        <button class="btn btn-danger btn-sm ml-auto" onclick="deleteServer()">Supprimer le serveur</button>
      <% } %>
    </div>

    <!-- Messages -->
    <div class="discord-messages" id="messagesContainer">
      <% if (messages.length === 0) { %>
        <div class="empty-state">
          <span class="empty-icon">#</span>
          Début du salon <strong>#<%= activeChannel?.name %></strong>. Envoie le premier message !
        </div>
      <% } else { %>
        <% messages.forEach(m => { %>
          <div class="discord-message" data-id="<%= m.id %>">
            <div class="msg-avatar"><%= m.username?.charAt(0).toUpperCase() %></div>
            <div class="msg-body">
              <div class="msg-header">
                <span class="msg-username">
                  <%= m.username %>
                  <% (m.user_roles || []).slice(0,2).forEach(r => { %>
                    <span class="role-pill" style="border-color:<%= r.color %>;color:<%= r.color %>"><%= r.name %></span>
                  <% }) %>
                </span>
                <span class="msg-time"><%= new Date(m.created_at).toLocaleString('fr-FR') %></span>
              </div>
              <div class="msg-content"><%= m.content %></div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- Input message -->
    <div class="discord-input-area">
      <textarea id="messageInput" placeholder="Message #<%= activeChannel?.name || 'général' %>" rows="1"></textarea>
      <button class="btn btn-primary btn-sm" onclick="sendMessage()">Envoyer</button>
    </div>

  </main>

</div>

<!-- Panel paramètres serveur (owner) -->
<div id="settingsPanel" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;align-items:center;justify-content:center;">
  <div class="auth-card" style="max-width:480px;width:90%;max-height:80vh;overflow-y:auto;">
    <h2 class="auth-title" style="font-size:1.1rem;margin-bottom:1.25rem;">Paramètres — <%= server.name %></h2>

    <!-- Rôles -->
    <div class="section-title">Rôles</div>
    <div id="rolesList">
      <% roles.forEach(r => { %>
        <div class="flex items-center gap-sm mb-sm" id="role-<%= r.id %>">
          <span class="role-pill" style="border-color:<%= r.color %>;color:<%= r.color %>"><%= r.name %></span>
          <span class="text-xs text-muted" style="flex:1;"><%= r.color %></span>
          <button class="btn btn-danger btn-sm" onclick="deleteRole(<%= r.id %>)">✕</button>
        </div>
      <% }) %>
    </div>

    <div class="flex gap-sm mt-sm mb-lg" style="flex-wrap:wrap;">
      <input type="text" id="newRoleName" placeholder="Nom du rôle" style="flex:1;min-width:100px;">
      <input type="color" id="newRoleColor" value="#00e5ff" style="width:40px;height:38px;padding:0.2rem;border-radius:0.5rem;border:1px solid var(--border);background:var(--bg4);cursor:pointer;">
      <button class="btn btn-primary btn-sm" onclick="createRole()">Créer</button>
    </div>

    <button class="btn btn-ghost w-full" style="justify-content:center;" onclick="closeSettings()">Fermer</button>
  </div>
</div>

<!-- Modal membre -->
<div id="memberModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;align-items:center;justify-content:center;">
  <div class="auth-card" style="max-width:380px;width:90%;">
    <h2 class="auth-title" style="font-size:1rem;margin-bottom:1rem;" id="memberModalTitle">Gérer le membre</h2>

    <div class="section-title">Assigner un rôle</div>
    <div class="flex gap-sm mb-md" style="flex-wrap:wrap;">
      <select id="roleSelect" style="flex:1;">
        <% roles.forEach(r => { %>
          <option value="<%= r.id %>"><%= r.name %></option>
        <% }) %>
      </select>
      <button class="btn btn-primary btn-sm" onclick="assignRole()">Assigner</button>
    </div>

    <div class="section-title">Retirer un rôle</div>
    <div class="flex gap-sm mb-md" style="flex-wrap:wrap;">
      <select id="removeRoleSelect" style="flex:1;">
        <% roles.forEach(r => { %>
          <option value="<%= r.id %>"><%= r.name %></option>
        <% }) %>
      </select>
      <button class="btn btn-warning btn-sm" onclick="removeRole()">Retirer</button>
    </div>

    <hr class="divider">
    <button class="btn btn-danger w-full" style="justify-content:center;" onclick="kickMember()">Expulser du serveur</button>
    <button class="btn btn-ghost w-full mt-sm" style="justify-content:center;" onclick="closeMemberModal()">Fermer</button>
  </div>
</div>

<!-- Modal nouveau salon -->
<div id="channelModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;align-items:center;justify-content:center;">
  <div class="auth-card" style="max-width:360px;width:90%;">
    <h2 class="auth-title" style="font-size:1rem;margin-bottom:1rem;">Nouveau salon</h2>
    <div class="form-group">
      <label>Nom du salon</label>
      <input type="text" id="channelName" placeholder="ex: annonces" maxlength="100">
    </div>
    <div class="flex gap-sm mt-sm">
      <button class="btn btn-primary" style="flex:1;justify-content:center;" onclick="createChannel()">Créer</button>
      <button class="btn btn-ghost" onclick="closeChannelModal()">Annuler</button>
    </div>
  </div>
</div>

<script>
  const SERVER_ID = <%= server.id %>;
  const ACTIVE_CHANNEL = <%= activeChannelId || 'null' %>;
  let lastMsgId = <%= messages.length > 0 ? messages[messages.length-1].id : 0 %>;
  let currentMemberId = null;

  // ===== MESSAGES =====
  const container = document.getElementById('messagesContainer');

  function scrollBottom() { container.scrollTop = container.scrollHeight; }
  scrollBottom();

  document.getElementById('messageInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });

  async function sendMessage() {
    const input = document.getElementById('messageInput');
    const content = input.value.trim();
    if (!content || !ACTIVE_CHANNEL) return;
    input.value = '';
    const res = await fetch(`/api/channels/${ACTIVE_CHANNEL}/messages`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content })
    });
    const data = await res.json();
    if (data.success) appendMessage(data.message);
    else input.value = content;
  }

  function escapeHtml(s) {
    return String(s || '').replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));
  }

  function appendMessage(m) {
    const isEmpty = container.querySelector('.empty-state');
    if (isEmpty) isEmpty.remove();
    const div = document.createElement('div');
    div.className = 'discord-message';
    div.dataset.id = m.id;
    div.innerHTML = `
      <div class="msg-avatar">${escapeHtml(m.username?.charAt(0).toUpperCase())}</div>
      <div class="msg-body">
        <div class="msg-header">
          <span class="msg-username">${escapeHtml(m.username)}</span>
          <span class="msg-time">${new Date(m.created_at).toLocaleString('fr-FR')}</span>
        </div>
        <div class="msg-content">${escapeHtml(m.content)}</div>
      </div>`;
    container.appendChild(div);
    lastMsgId = m.id;
    scrollBottom();
  }

  // Polling nouveaux messages
  if (ACTIVE_CHANNEL) {
    setInterval(async () => {
      try {
        const msgs = await (await fetch(`/api/channels/${ACTIVE_CHANNEL}/messages?after=${lastMsgId}`)).json();
        msgs.forEach(appendMessage);
      } catch(e) {}
    }, 3000);
  }

  // ===== SERVEUR =====
  async function leaveServer() {
    if (!confirm('Quitter ce serveur ?')) return;
    const res = await fetch(`/api/servers/${SERVER_ID}/leave`, { method: 'POST' });
    if ((await res.json()).success) window.location.href = '/servers';
    else alert('Erreur');
  }

  async function deleteServer() {
    if (!confirm('Supprimer définitivement ce serveur et tout son contenu ?')) return;
    const res = await fetch(`/api/servers/${SERVER_ID}/delete`, { method: 'POST' });
    if ((await res.json()).success) window.location.href = '/servers';
    else alert('Erreur');
  }

  // ===== SALONS =====
  function openChannelModal() { document.getElementById('channelModal').style.display = 'flex'; }
  function closeChannelModal() { document.getElementById('channelModal').style.display = 'none'; }

  async function createChannel() {
    const name = document.getElementById('channelName').value.trim();
    if (!name) return alert('Nom requis');
    const res = await fetch(`/api/servers/${SERVER_ID}/channels`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name })
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert('❌ ' + (data.error || 'Erreur'));
  }

  async function deleteChannel(e, channelId) {
    e.preventDefault(); e.stopPropagation();
    if (!confirm('Supprimer ce salon ?')) return;
    const res = await fetch(`/api/channels/${channelId}/delete`, { method: 'POST' });
    if ((await res.json()).success) location.reload();
    else alert('Erreur');
  }

  // ===== RÔLES =====
  function toggleSettings() {
    const p = document.getElementById('settingsPanel');
    p.style.display = p.style.display === 'flex' ? 'none' : 'flex';
  }
  function closeSettings() { document.getElementById('settingsPanel').style.display = 'none'; }

  async function createRole() {
    const name = document.getElementById('newRoleName').value.trim();
    const color = document.getElementById('newRoleColor').value;
    if (!name) return alert('Nom requis');
    const res = await fetch(`/api/servers/${SERVER_ID}/roles`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, color })
    });
    const data = await res.json();
    if (data.success) location.reload();
    else alert('❌ ' + (data.error || 'Erreur'));
  }

  async function deleteRole(roleId) {
    if (!confirm('Supprimer ce rôle ?')) return;
    const res = await fetch(`/api/roles/${roleId}/delete`, { method: 'POST' });
    if ((await res.json()).success) document.getElementById(`role-${roleId}`)?.remove();
    else alert('Erreur');
  }

  // ===== MEMBRES =====
  function openMemberModal(userId, username) {
    currentMemberId = userId;
    document.getElementById('memberModalTitle').textContent = `Gérer ${username}`;
    document.getElementById('memberModal').style.display = 'flex';
  }
  function closeMemberModal() { document.getElementById('memberModal').style.display = 'none'; currentMemberId = null; }

  async function assignRole() {
    if (!currentMemberId) return;
    const roleId = document.getElementById('roleSelect').value;
    const res = await fetch(`/api/servers/${SERVER_ID}/members/${currentMemberId}/roles`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ roleId })
    });
    const data = await res.json();
    alert(data.success ? '✅ Rôle assigné' : '❌ ' + (data.error || 'Erreur'));
    if (data.success) location.reload();
  }

  async function removeRole() {
    if (!currentMemberId) return;
    const roleId = document.getElementById('removeRoleSelect').value;
    const res = await fetch(`/api/servers/${SERVER_ID}/members/${currentMemberId}/roles/remove`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ roleId })
    });
    const data = await res.json();
    alert(data.success ? '✅ Rôle retiré' : '❌ ' + (data.error || 'Erreur'));
    if (data.success) location.reload();
  }

  async function kickMember() {
    if (!currentMemberId) return;
    if (!confirm('Expulser ce membre ?')) return;
    const res = await fetch(`/api/servers/${SERVER_ID}/members/${currentMemberId}/kick`, { method: 'POST' });
    const data = await res.json();
    if (data.success) location.reload();
    else alert('❌ ' + (data.error || 'Erreur'));
  }

  // Fermer les modals en cliquant dehors
  ['settingsPanel','memberModal','channelModal'].forEach(id => {
    document.getElementById(id).addEventListener('click', (e) => {
      if (e.target.id === id) {
        e.target.style.display = 'none';
        if (id === 'memberModal') currentMemberId = null;
      }
    });
  });
</script>
</body>
</html>
