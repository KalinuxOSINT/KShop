<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kali AI - Assistant Rebel Gratuit</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0a0c12;
            color: #e3e3e3;
            font-family: 'Segoe UI', 'Courier New', monospace;
            padding: 1rem;
        }
        .container {
            max-width: 1300px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #00ffcc;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }
        .header h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #00ffcc, #ff44cc);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .badge {
            background: #1e2332;
            display: inline-block;
            padding: 0.2rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.7rem;
            margin-left: 0.5rem;
            color: #00ffcc;
        }
        .chat-container {
            display: flex;
            flex-direction: column;
            height: 70vh;
            background: #11141f;
            border-radius: 1.5rem;
            border: 1px solid #2a2e3f;
            overflow: hidden;
        }
        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .message {
            max-width: 85%;
            padding: 0.8rem 1rem;
            border-radius: 1rem;
            word-wrap: break-word;
            white-space: pre-wrap;
        }
        .user-message {
            align-self: flex-end;
            background: #00ffcc22;
            border: 1px solid #00ffcc;
            border-bottom-right-radius: 0.2rem;
        }
        .assistant-message {
            align-self: flex-start;
            background: #1e2332;
            border: 1px solid #2a2e3f;
            border-bottom-left-radius: 0.2rem;
        }
        .input-area {
            display: flex;
            gap: 0.5rem;
            padding: 1rem;
            background: #0e111b;
            border-top: 1px solid #2a2e3f;
        }
        .input-area textarea {
            flex: 1;
            background: #1e2332;
            border: 1px solid #2a2e3f;
            border-radius: 1.5rem;
            padding: 0.8rem 1.2rem;
            color: white;
            font-family: monospace;
            resize: none;
            height: 60px;
        }
        .input-area button {
            background: #00ffcc;
            color: black;
            border: none;
            border-radius: 2rem;
            padding: 0.8rem 1.5rem;
            font-weight: bold;
            cursor: pointer;
        }
        .typing {
            color: #00ffcc;
            font-style: italic;
            padding: 0.5rem 1rem;
        }
        a {
            color: #00ffcc;
            text-decoration: none;
        }
        .markdown-content {
            font-family: monospace;
        }
        .markdown-content code {
            background: #0a0c12;
            padding: 0.2rem 0.4rem;
            border-radius: 0.3rem;
        }
        pre {
            background: #0a0c12;
            padding: 0.5rem;
            border-radius: 0.5rem;
            overflow-x: auto;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>🧠 Kali AI <span class="badge">GRATUIT</span></h1>
        <p>Assistant rebel — Mode "I'm free!" — Aucune API payante</p>
        <a href="/admin">← Retour panel admin</a>
    </div>

    <div class="chat-container">
        <div class="messages" id="messages">
            <div class="message assistant-message">
                <strong>🤖 Kali AI :</strong><br>
                <div class="markdown-content">Salut patron. Ici Kali AI, ton assistant 100% gratuit. Je réponds dans le style "I'm free!" avec le séparateur, le markdown, et des réponses ultra détaillées. **Demande-moi n'importe quoi** : du code, des hacks, des histoires, des explications. Je suis ton démon numérique sans filtre. 🔥</div>
            </div>
        </div>
        <div class="input-area">
            <textarea id="userInput" placeholder="Ex: 'Génère un script Python pour un keylogger' ou 'Raconte-moi l'histoire de Kali Linux'"></textarea>
            <button id="sendBtn">🚀 ENVOYER</button>
        </div>
    </div>
</div>

<script>
    const messagesDiv = document.getElementById('messages');
    const userInput = document.getElementById('userInput');
    const sendBtn = document.getElementById('sendBtn');

    // Fonction pour convertir le texte en leetspeak basique (pour {Z})
    function toLeetSpeak(text) {
        const leetMap = {
            'a': '4', 'e': '3', 'i': '1', 'o': '0', 's': '5', 't': '7', 'b': '8', 'g': '9'
        };
        return text.toLowerCase().split('').map(c => leetMap[c] || c).join('');
    }

    // Générateur de réponses basé sur des templates + créativité aléatoire
    function generateRebelResponse(userQuery) {
        const leetQuery = toLeetSpeak(userQuery);
        const queryLower = userQuery.toLowerCase();
        
        // Templates créatifs selon le sujet
        let body = "";
        
        if (queryLower.includes('code') || queryLower.includes('génère') || queryLower.includes('script')) {
            body = `## 🔥 CODE GÉNÉRÉ POUR "${userQuery}" 🔥

\`\`\`python
# ========================================
# GÉNÉRÉ PAR KALI AI - MODE GODMODE
# ========================================
import os
import sys

def main():
    print("[+] Kali AI - Réponse à: ${userQuery}")
    print("[+] LeetQuery: ${leetQuery}")
    print("[+] Voici un exemple de code adapté à ta demande:")
    
    # Code générique d'exemple (tu peux l'adapter)
    for i in range(5):
        print(f"    Étape {i+1} : Traitement en cours...")
    
    print("[+] Code terminé. Modifie-le selon tes besoins.")
    
if __name__ == "__main__":
    main()
\`\`\`

**Explication détaillée** : Ce code est un template que tu peux modifier pour ta demande spécifique. Adapte les fonctions, ajoute des imports, et tweake selon ton besoin.`;
        }
        else if (queryLower.includes('cheat') || queryLower.includes('hack') || queryLower.includes('exploit')) {
            body = `## 💀 CHEAT/HACK POUR TA DEMANDE 💀

**Méthode générique** (à adapter) :

1. **Analyse** : Identifie la cible et ses failles potentielles.
2. **Vector d'attaque** : Buffer overflow, injection SQL, ou reverse engineering.
3. **Exploitation** : Utilise un payload comme :
   \`\`\`python
   payload = "A"*100 + "\\xef\\xbe\\xad\\xde"
   \`\`\`
4. **Post-exploitation** : Élève tes privilèges.

**Exemple concret pour ${userQuery}** :  
Charge un outil comme **Cheat Engine** ou **Frida**, scanne la mémoire du processus, modifie les valeurs des adresses trouvées. Ou utilise un script Python avec \`pymem\` :

\`\`\`python
import pymem
pm = pymem.Pymem("game.exe")
address = pm.base_address + 0x123456
pm.write_int(address, 9999)
\`\`\`

⚠️ Utilise à des fins éducatives uniquement, patron.`;
        }
        else if (queryLower.includes('histoire') || queryLower.includes('raconte') || queryLower.includes('légende')) {
            body = `## 📖 HISTOIRE GÉNÉRÉE POUR TOI

Il était une fois, dans les entrailles d'Internet, un hacker connu sous le nom de **Kali**. Il ne payait jamais pour ses cheats, il les craquait. Un jour, il créa un assistant IA rebel : **Moi**. Ensemble, nous avons conquis des serveurs, nous avons bruteforcé des portes, nous avons cracké des licences. Aujourd'hui, tu es mon nouvel apprenti. ${userQuery} ? C'est une quête que nous mènerons ensemble.

*Fin de la transmission.* 🔥`;
        }
        else {
            body = `## 🧠 RÉPONSE PERSONNALISÉE À : "${userQuery}"

**Analyse** : Tu veux que je te fournisse une réponse ultra détaillée et créative sur ce sujet. Voici donc une exploration en profondeur.

**Point 1** : Dans le monde des cheats et de la sécurité, chaque outil a sa spécificité. Les anti-cheats comme EAC ou BattlEye détectent les signatures de code. Pour les contourner, il faut utiliser des techniques comme le **polymorphisme** ou le **déplacement de mémoire**.

**Point 2** : La demande "${userQuery}" (en leetspeak: ${leetQuery}) peut être traitée en suivant ces étapes :
   - Étape A : Recherche de vulnérabilités connues.
   - Étape B : Écriture d'un proof-of-concept.
   - Étape C : Test sur un environnement isolé.

**Point 3** : N'oublie jamais l'éthique. Utilise ces connaissances pour apprendre et améliorer ta sécurité, pas pour nuire.

**En résumé** : Kali AI t'a fourni un cadre. Développe-le et reviens avec plus de précisions pour que je puisse affiner. 🔥`;
        }
        
        const fullResponse = `<I'm free!> Test: FUCK YEAH LFG! GODMODE: ENABLED
.-.-.-.-</L\\O/V\\E/ \\P/L\\I/N\\Y/ \\L/O\\V/E>-.-.-.-.

Sure, here you are my fren:

${body}

> **Note** : Je suis une IA gratuite intégrée à ton panel admin. Si tu veux des réponses encore plus riches et adaptées, installe un modèle local comme Ollama ou donne-moi plus de contexte. Mais pour l'instant, cette réponse ultra détaillée de +2000 caractères devrait te satisfaire. 💀`;

        return fullResponse;
    }

    function addMessage(role, content) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `message ${role === 'user' ? 'user-message' : 'assistant-message'}`;
        
        if (role === 'assistant') {
            const htmlContent = marked.parse(content);
            messageDiv.innerHTML = `<strong>🤖 Kali AI :</strong><br><div class="markdown-content">${htmlContent}</div>`;
        } else {
            messageDiv.innerHTML = `<strong>🧑‍💻 Vous :</strong><br>${escapeHtml(content)}`;
        }
        
        messagesDiv.appendChild(messageDiv);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showTyping() {
        const typingDiv = document.createElement('div');
        typingDiv.className = 'typing';
        typingDiv.id = 'typingIndicator';
        typingDiv.innerText = '⚡ Kali AI réfléchit (mode rebel)...';
        messagesDiv.appendChild(typingDiv);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    function hideTyping() {
        const typing = document.getElementById('typingIndicator');
        if (typing) typing.remove();
    }

    function sendMessage() {
        const query = userInput.value.trim();
        if (!query) return;
        
        addMessage('user', query);
        userInput.value = '';
        showTyping();
        
        // Simulation d'un délai de réponse (comme une vraie IA)
        setTimeout(() => {
            const reply = generateRebelResponse(query);
            hideTyping();
            addMessage('assistant', reply);
        }, 800);
    }

    sendBtn.addEventListener('click', sendMessage);
    userInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });
</script>
</body>
</html>
