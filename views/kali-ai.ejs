<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kali AI - Assistant Intégré</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0a0c12;
            color: #e3e3e3;
            font-family: 'Segoe UI', 'Courier New', monospace;
            padding: 1rem;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #00ffcc;
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }
        .header h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #00ffcc, #ff44cc);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .badge {
            background: #1e2332;
            display: inline-block;
            padding: 0.2rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.7rem;
            margin-left: 0.5rem;
            color: #00ffcc;
        }
        .chat-container {
            display: flex;
            flex-direction: column;
            height: 70vh;
            background: #11141f;
            border-radius: 1.5rem;
            border: 1px solid #2a2e3f;
            overflow: hidden;
        }
        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .message {
            max-width: 85%;
            padding: 0.8rem 1rem;
            border-radius: 1rem;
            word-wrap: break-word;
            white-space: pre-wrap;
        }
        .user-message {
            align-self: flex-end;
            background: #00ffcc22;
            border: 1px solid #00ffcc;
            border-bottom-right-radius: 0.2rem;
        }
        .assistant-message {
            align-self: flex-start;
            background: #1e2332;
            border: 1px solid #2a2e3f;
            border-bottom-left-radius: 0.2rem;
        }
        .input-area {
            display: flex;
            gap: 0.5rem;
            padding: 1rem;
            background: #0e111b;
            border-top: 1px solid #2a2e3f;
        }
        .input-area textarea {
            flex: 1;
            background: #1e2332;
            border: 1px solid #2a2e3f;
            border-radius: 1.5rem;
            padding: 0.8rem 1.2rem;
            color: white;
            font-family: monospace;
            resize: none;
            height: 60px;
        }
        .input-area button {
            background: #00ffcc;
            color: black;
            border: none;
            border-radius: 2rem;
            padding: 0.8rem 1.5rem;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }
        .input-area button:hover {
            filter: brightness(1.1);
            transform: scale(0.98);
        }
        .typing {
            color: #00ffcc;
            font-style: italic;
            padding: 0.5rem 1rem;
        }
        a {
            color: #00ffcc;
            text-decoration: none;
            display: inline-block;
            margin-top: 1rem;
        }
        pre {
            background: #0a0c12;
            padding: 0.5rem;
            border-radius: 0.5rem;
            overflow-x: auto;
        }
        .markdown-content {
            font-family: monospace;
        }
        .markdown-content code {
            background: #0a0c12;
            padding: 0.2rem 0.4rem;
            border-radius: 0.3rem;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
<div class="container">
