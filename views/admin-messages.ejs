<!DOCTYPE html>
<html>
<head>
    <title>KaliNet - Admin Messages</title>
    <style>
        body{background:#0a0c12;color:#eee;font-family:Arial;padding:2rem;}
        .container{max-width:1200px;margin:0 auto;}
        .message-card{background:#1a1f2e;border-radius:1rem;padding:1rem;margin-bottom:1rem;border-left:4px solid #00ffcc;}
        .message-card.pending{border-left-color:#ffaa00;}
        .message-card.replied{border-left-color:#00aaff;}
        .message-card.resolved{border-left-color:#ff4444;opacity:0.7;}
        .subject{font-size:1.2rem;font-weight:bold;color:#00ffcc;}
        .user{color:#ffaa00;}
        .status{padding:0.2rem 0.5rem;border-radius:1rem;font-size:0.7rem;margin-left:0.5rem;}
        .status.pending{background:#ffaa00;color:black;}
        .status.replied{background:#00aaff;color:white;}
        .status.resolved{background:#ff4444;color:white;}
        .message{background:#1e2332;padding:0.5rem;border-radius:0.5rem;margin:0.5rem 0;}
        .reply-area{display:none;margin-top:0.5rem;}
        textarea{width:100%;padding:0.5rem;background:#1e2332;border:1px solid #00ffcc;color:white;border-radius:0.5rem;}
        button{background:#00ffcc;color:black;padding:0.3rem 0.8rem;border:none;border-radius:1rem;cursor:pointer;margin-right:0.5rem;}
        .btn-reply{background:#00aaff;}
        .btn-resolve{background:#ff4444;}
        .nav a{color:#00ffcc;text-decoration:none;margin-right:1rem;}
        .date{font-size:0.7rem;color:#888;margin-top:0.5rem;}
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="/admin/users">👥 Utilisateurs</a>
        <a href="/">🏠 Accueil</a>
    </div>
    <h1>📩 Messages reçus</h1>
    <% if (messages.length === 0) { %>
        <p>Aucun message pour le moment.</p>
    <% } else { %>
        <% messages.forEach(m => { %>
            <div class="message-card <%= m.status %>" id="msg-<%= m.id %>">
                <div>
                    <span class="subject"><%= m.subject %></span>
                    <span class="status <%= m.status %>">
                        <% if (m.status === 'pending') { %>⏳ En attente<% } 
                           else if (m.status === 'replied') { %>💬 Répondu<% } 
                           else { %>✅ Résolu<% } %>
                    </span>
                </div>
                <div><span class="user">👤 <%= m.users.username %></span> (ID: <%= m.user_id %>)</div>
                <div class="message"><%= m.message %></div>
                <% if (m.admin_reply) { %>
                    <div style="background:#0a0c12;padding:0.5rem;border-radius:0.5rem;margin-top:0.5rem;">
                        <strong>📤 Votre réponse :</strong> <%= m.admin_reply %>
                    </div>
                <% } %>
                <div class="date">📅 Reçu le : <%= new Date(m.created_at).toLocaleString() %></div>
                
                <div style="margin-top:0.5rem;">
                    <button class="btn-reply" onclick="showReplyForm(<%= m.id %>)">💬 Répondre</button>
                    <button class="btn-resolve" onclick="resolveMessage(<%= m.id %>)">✅ Marquer résolu</button>
                </div>
                
                <div id="reply-form-<%= m.id %>" class="reply-area">
                    <textarea id="reply-text-<%= m.id %>" rows="3" placeholder="Écrire une réponse..."></textarea>
                    <button onclick="sendReply(<%= m.id %>)">📤 Envoyer la réponse</button>
                    <button onclick="hideReplyForm(<%= m.id %>)">Annuler</button>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>
<script>
    function showReplyForm(id) {
        document.getElementById(`reply-form-${id}`).style.display = 'block';
    }
    function hideReplyForm(id) {
        document.getElementById(`reply-form-${id}`).style.display = 'none';
    }
    async function sendReply(id) {
        const reply = document.getElementById(`reply-text-${id}`).value;
        if (!reply.trim()) return alert('Écris une réponse');
        const res = await fetch('/api/admin/messages/reply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messageId: id, reply })
        });
        if (res.ok) {
            location.reload();
        } else {
            alert('Erreur');
        }
    }
    async function resolveMessage(id) {
        const res = await fetch('/api/admin/messages/resolve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messageId: id })
        });
        if (res.ok) location.reload();
        else alert('Erreur');
    }
</script>
</body>
</html>
