<!DOCTYPE html>
<html>
<head>
    <link rel="icon" type="image/x-icon" href="/Favicon.ico">
    <title>Kalinux - Inscription</title>
    <style>
        body {
            background: #0a0c12;
            color: #eee;
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 2rem;
        }
        .logo {
            width: 80px;
            height: auto;
            margin-bottom: 1rem;
        }
        input, button {
            padding: 0.5rem;
            margin: 0.5rem;
            border-radius: 0.5rem;
            border: none;
        }
        input {
            background: #1a1f2e;
            color: white;
            border: 1px solid #00ffcc;
        }
        button {
            background: #00ffcc;
            color: black;
            cursor: pointer;
            font-weight: bold;
        }
        a {
            color: #00ffcc;
            text-decoration: none;
        }
        .container {
            max-width: 400px;
            margin: 0 auto;
            background: #1a1f2e;
            padding: 2rem;
            border-radius: 1rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="/Kalinux.png" alt="Kalinux Logo" class="logo" onerror="this.style.display='none'">
        <h1>📝 Inscription</h1>
        <form method="post" action="/register">
            <input type="text" name="username" placeholder="Nom d'utilisateur" required autocomplete="off"><br>
            <input type="password" name="password" placeholder="Mot de passe" required><br>
            <button type="submit">Créer mon compte</button>
        </form>
        <p><a href="/login">Déjà un compte ? Se connecter</a></p>
    </div>
</body>
</html>
