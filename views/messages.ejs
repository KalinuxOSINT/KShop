<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/Favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
  <title>KaliNet — Messages</title>
</head>
<body>

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
    KaliNet
  </a>
  <div class="navbar-links">
    <a href="/">Fil</a>
    <a href="/servers">Serveurs</a>
    <a href="/messages" class="active">Messages</a>
    <a href="/profile/<%= user.id %>">Profil</a>
    <a href="/contact">Contact</a>
    <% if (user.is_admin) { %>
      <a href="/admin/users" class="danger">Admin</a>
      <a href="/admin/messages">
        Admin msg
        <span id="unreadBadge" style="display:none;background:var(--red);color:white;border-radius:2rem;padding:0.1rem 0.4rem;font-size:0.62rem;">0</span>
      </a>
    <% } %>
  </div>
  <div class="navbar-user">
    <a href="/logout" class="btn btn-ghost btn-sm">Déco</a>
  </div>
</nav>

<div class="page-wrapper-wide">
  <div class="messages-layout">

    <!-- Conversations -->
    <div class="conversations-panel">
      <h3>Conversations</h3>
      <% conversations.forEach(c => { %>
        <div class="conversation-item" onclick="loadChat(<%= c.id %>)" data-id="<%= c.id %>">
          <div class="conv-name">
            <span class="badge badge-<%= c.rank %>" style="font-size:0.6rem;">
              <% if (c.rank==='admin') { %>👑
              <% } else if (c.rank==='vip') { %>⭐
              <% } else if (c.rank==='premium') { %>💎
              <% } else if (c.rank==='tester') { %>🧪
              <% } else if (c.rank==='banned') { %>🔒
              <% } else { %>👤<% } %>
            </span>
            <span class="<% if(c.rank==='banned'){%>text-danger<%}%>"><%= c.username %></span>
            <% if (c.unread > 0) { %><span class="unread-dot"><%= c.unread %></span><% } %>
          </div>
          <div class="conv-preview"><%= c.last_message || 'Nouvelle conversation' %></div>
        </div>
      <% }) %>
    </div>

    <!-- Chat -->
    <div class="chat-panel">
      <div class="chat-header" id="chatHeader">
        <span class="text-muted text-sm">Sélectionne une conversation</span>
      </div>

      <div id="chatControls" style="display:none;padding:0.6rem 0.85rem;border-bottom:1px solid var(--border);gap:0.4rem;background:var(--bg3);" class="flex">
        <button class="btn btn-ghost btn-sm" onclick="setPin()">🔒 PIN</button>
        <button class="btn btn-ghost btn-sm" onclick="requestReset()" style="color:var(--yellow)">🔄 Reset PIN</button>
        <button class="btn btn-ghost btn-sm" onclick="approveReset()" style="color:var(--green)">✅ Approuver</button>
      </div>

      <div class="chat-messages" id="messagesContainer">
        <div class="empty-state">
          <span class="empty-icon">💬</span>
          Choisis une conversation
        </div>
      </div>

      <div class="chat-input-area">
        <textarea id="messageInput" rows="2" placeholder="Écris ton message..."></textarea>
        <input type="file" id="fileInput" style="display:none;">
        <button class="btn btn-ghost btn-sm" onclick="document.getElementById('fileInput').click()">📎</button>
        <button class="btn btn-primary btn-sm" onclick="sendMessage()">Envoyer</button>
      </div>
    </div>

  </div>
</div>

<script>
  let currentUserId = null;
  if (!window.unlocked) window.unlocked = [];

  function getConvKey(a, b) { return Math.min(a,b) + '-' + Math.max(a,b); }

  async function loadChat(userId) {
    currentUserId = userId;
    document.querySelectorAll('.conversation-item').forEach(el => el.classList.remove('active'));
    document.querySelector(`.conversation-item[data-id="${userId}"]`)?.classList.add('active');
    document.getElementById('chatControls').style.display = 'flex';
    const convKey = getConvKey(<%= user.id %>, userId);
    if (window.unlocked.includes(convKey)) { await fetchMessages(userId); return; }
    const { hasPin } = await (await fetch('/api/conversation/has-pin/' + userId)).json();
    if (hasPin) {
      const pin = prompt('🔒 Conversation protégée — entrez le PIN :');
      if (pin === null) return;
      const result = await (await fetch('/api/conversation/verify-pin', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ otherId: userId, pin }) })).json();
      if (result.success) { window.unlocked.push(convKey); await fetchMessages(userId); }
      else alert('❌ PIN incorrect');
    } else {
      window.unlocked.push(convKey);
      await fetchMessages(userId);
    }
  }

  async function fetchMessages(userId) {
    const messages = await (await fetch('/api/messages/' + userId)).json();
    const container = document.getElementById('messagesContainer');
    const conv = document.querySelector(`.conversation-item[data-id="${userId}"] .conv-name span:nth-child(2)`);
    document.getElementById('chatHeader').innerHTML = `<span class="font-bold">💬 ${conv ? conv.textContent.trim() : 'Conversation'}</span>`;
    if (!messages || messages.length === 0) {
      container.innerHTML = '<div class="empty-state"><span class="empty-icon">✉️</span>Aucun message. Envoie le premier !</div>';
      return;
    }
    container.innerHTML = messages.map(m => {
      const isSent = m.sender_id == <%= user.id %>;
      let content = escapeHtml(m.content || '');
      if (content.includes('/storage/v1/object/public/')) {
        const match = content.match(/(https?:\/\/[^\s]+)/);
        if (match) content = `📎 <a href="${match[0]}" target="_blank" style="color:var(--accent)">Voir le fichier</a>`;
      }
      return `<div class="message-bubble ${isSent ? 'sent' : 'received'}">
        ${!isSent ? `<div class="msg-sender">${escapeHtml(m.username)}</div>` : ''}
        ${content}
        <div class="msg-time">${new Date(m.created_at).toLocaleString('fr-FR')}</div>
      </div>`;
    }).join('');
    container.scrollTop = container.scrollHeight;
  }

  async function sendMessage() {
    if (!currentUserId) return;
    const convKey = getConvKey(<%= user.id %>, currentUserId);
    if (!window.unlocked.includes(convKey)) return alert('🔒 Conversation verrouillée');
    const content = document.getElementById('messageInput').value;
    if (!content.trim()) return;
    const res = await fetch('/api/messages/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ receiver_id: currentUserId, content }) });
    if (res.ok) { document.getElementById('messageInput').value = ''; fetchMessages(currentUserId); }
  }

  async function setPin() {
    if (!currentUserId) return;
    const pin = prompt('Nouveau PIN (4 chiffres min) :');
    if (!pin || pin.length < 4 || !/^\d+$/.test(pin)) return alert('PIN invalide');
    const data = await (await fetch('/api/conversation/set-pin', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ otherId: currentUserId, pin }) })).json();
    alert(data.success ? '✅ PIN défini' : '❌ ' + (data.error || 'Erreur'));
  }

  async function requestReset() {
    if (!currentUserId) return;
    const data = await (await fetch('/api/conversation/request-reset', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ otherId: currentUserId }) })).json();
    alert(data.success ? '✅ Demande envoyée' : '❌ ' + (data.error || 'Erreur'));
  }

  async function approveReset() {
    if (!currentUserId) return;
    const data = await (await fetch('/api/conversation/approve-reset', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ otherId: currentUserId }) })).json();
    if (data.success) { window.unlocked = window.unlocked.filter(k => k !== getConvKey(<%= user.id %>, currentUserId)); loadChat(currentUserId); }
    else alert('❌ ' + (data.error || 'Erreur'));
  }

  document.getElementById('fileInput').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file || !currentUserId) return;
    if (file.size > 10 * 1024 * 1024) return alert('Fichier trop gros (max 10MB)');
    const formData = new FormData();
    formData.append('file', file);
    formData.append('receiver_id', currentUserId);
    const res = await fetch('/api/messages/upload', { method:'POST', body: formData });
    if (res.ok) fetchMessages(currentUserId);
    else alert('Erreur upload');
    e.target.value = '';
  });

  function escapeHtml(str) {
    return str.replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));
  }

  document.getElementById('messageInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });

  async function checkUnread() {
    <% if (user.is_admin) { %>
    try {
      const data = await (await fetch('/api/admin/messages/unread-count')).json();
      const badge = document.getElementById('unreadBadge');
      if (badge) { badge.innerText = data.count||0; badge.style.display = data.count > 0 ? 'inline' : 'none'; }
    } catch(e) {}
    <% } %>
  }

  setInterval(() => {
    if (currentUserId && window.unlocked.includes(getConvKey(<%= user.id %>, currentUserId))) fetchMessages(currentUserId);
  }, 5000);
  setInterval(checkUnread, 30000);
  checkUnread();
</script>
</body>
</html>
