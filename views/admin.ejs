<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/Favicon.ico">
  <link rel="stylesheet" href="/style.css">
  <title>KaliNet — Panel Admin</title>
</head>
<body>

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <img src="/Kalinux.png" alt="Logo" onerror="this.style.display='none'">
    KaliNet
  </a>
  <div class="navbar-links">
    <a href="/">Fil</a>
    <a href="/admin/users" class="active danger">Utilisateurs</a>
    <a href="/admin/reports" style="color:var(--yellow)">Signalements</a>
    <a href="/admin/messages" style="color:var(--blue)">Messages</a>
  </div>
  <div class="navbar-user">
    <span class="badge badge-admin">👑 Admin</span>
    <a href="/logout" class="btn btn-ghost btn-sm">Déco</a>
  </div>
</nav>

<div class="page-wrapper">
  <div class="section-title">Panel Admin</div>

  <div class="card mb-lg">
    <div class="section-title">Ajouter un produit</div>
    <form method="post" action="/admin/products/add" class="flex gap-sm" style="flex-wrap:wrap;align-items:flex-end;">
      <div class="form-group" style="flex:1;min-width:140px;margin-bottom:0;">
        <label>Nom</label>
        <input type="text" name="name" placeholder="Nom du produit" required>
      </div>
      <div class="form-group" style="flex:2;min-width:160px;margin-bottom:0;">
        <label>Description</label>
        <input type="text" name="description" placeholder="Description">
      </div>
      <div class="form-group" style="width:140px;margin-bottom:0;">
        <label>Prix (centimes)</label>
        <input type="number" name="price" placeholder="ex: 999" required>
      </div>
      <div class="form-group" style="width:140px;margin-bottom:0;">
        <label>Catégorie</label>
        <input type="text" name="category" placeholder="Catégorie">
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Ajouter</button>
    </form>
  </div>

  <div class="section-title">Produits existants</div>

  <% if (products && products.length > 0) { %>
    <% products.forEach(p => { %>
      <div class="card mb-sm">
        <div class="flex items-center gap-md">
          <div style="flex:1;">
            <div class="font-bold"><%= p.name %></div>
            <div class="text-sm text-muted mt-sm"><%= p.description %></div>
            <div class="text-sm mt-sm flex gap-sm">
              <span class="text-accent"><%= (p.price/100).toFixed(2) %> €</span>
              <span class="text-muted">·</span>
              <span class="text-muted"><%= p.category %></span>
            </div>
          </div>
          <form method="post" action="/admin/products/delete/<%= p.id %>">
            <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state">
      <span class="empty-icon">📦</span>
      Aucun produit pour le moment.
    </div>
  <% } %>
</div>
</body>
</html>
