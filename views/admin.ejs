<!DOCTYPE html>
<html>
<head>
    <title>Kalinux - Panel Admin</title>
    <style>
        body{background:#0a0c12;color:#eee;font-family:Arial;padding:2rem;}
        .container{max-width:800px;margin:0 auto;}
        .logo{width:50px;height:auto;vertical-align:middle;margin-right:10px;}
        h1, h2{color:#00ffcc;display:flex;align-items:center;}
        a,button{
            background:#00ffcc;
            color:black;
            padding:0.5rem 1rem;
            border-radius:2rem;
            text-decoration:none;
            border:none;
            cursor:pointer;
        }
        form{display:inline;}
        input,select{
            padding:0.5rem;
            margin:0.5rem;
            background:#1a1f2e;
            border:1px solid #00ffcc;
            color:white;
            border-radius:0.5rem;
        }
        .product-item{
            background:#1a1f2e;
            margin:1rem 0;
            padding:1rem;
            border-radius:1rem;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
        .nav{display:flex;gap:1rem;margin-bottom:2rem;flex-wrap:wrap;}
        .nav a{background:transparent;color:#00ffcc;padding:0;}
        .nav a:hover{text-decoration:underline;}
    </style>
</head>
<body>
<div class="container">
    <div class="nav">
        <a href="/">🏠 Accueil</a>
        <a href="/admin/users">👥 Utilisateurs</a>
        <a href="/admin/messages">📩 Messages reçus</a>
        <a href="/logout">🚪 Déconnexion</a>
    </div>

    <h1>👑 Panel Admin</h1>

    <h2>➕ Ajouter un cheat</h2>
    <form method="post" action="/admin/products/add">
        <input type="text" name="name" placeholder="Nom du cheat" required>
        <input type="text" name="description" placeholder="Description">
        <input type="number" name="price" placeholder="Prix (centimes)" required>
        <input type="text" name="category" placeholder="Catégorie (FPS, RPG, etc.)">
        <button type="submit">Ajouter</button>
    </form>

    <h2>📦 Cheats existants</h2>
    <% if (products && products.length > 0) { %>
        <% products.forEach(p => { %>
            <div class="product-item">
                <div>
                    <strong><%= p.name %></strong><br>
                    <%= p.description %><br>
                    <span style="color:#00ffcc"><%= (p.price/100).toFixed(2) %> €</span> - <%= p.category %>
                </div>
                <form method="post" action="/admin/products/delete/<%= p.id %>">
                    <button type="submit" style="background:#ff4444; color:white;">❌ Supprimer</button>
                </form>
            </div>
        <% }) %>
    <% } else { %>
        <p>Aucun cheat pour le moment. Ajoutes-en un !</p>
    <% } %>
</div>
</body>
</html>
